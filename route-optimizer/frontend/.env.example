# Copy to .env.local and fill from Supabase → Project Settings → API (or Connect panel).
# VITE_SUPABASE_URL = Project URL, e.g. https://YOUR_REF.supabase.co
# VITE_SUPABASE_ANON_KEY = publishable key (sb_publishable_...) or legacy anon JWT (eyJ...)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional: route-optimizer backend (optimize + address autocomplete). Default http://localhost:8000
# VITE_API_URL=https://your-api.example.com
